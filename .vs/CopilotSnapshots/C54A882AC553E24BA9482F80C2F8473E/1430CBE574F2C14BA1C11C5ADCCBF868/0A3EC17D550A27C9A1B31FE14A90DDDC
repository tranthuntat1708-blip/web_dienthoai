namespace Web_NoiThat.Server.DTOs;

// ── REQUEST ──────────────────────────────────────────────

public record ProductFilterRequest(
    int? CategoryId,
    string? Material,
    string? Style,
    string? Color,
    decimal? MinPrice,
    decimal? MaxPrice,
    string? SortBy,      // "newest" | "price_asc" | "price_desc" | "best_seller"
    int Page = 1,
    int PageSize = 12
);

// ── RESPONSE ─────────────────────────────────────────────

/// <summary>
/// Card sản phẩm dùng cho danh sách / grid
/// </summary>
public record ProductCardDto(
    int Id,
    string Name,
    string Slug,
    string MainImageUrl,
    decimal Price,
    decimal? SalePrice,
    bool IsOnSale,
    string Material,
    string Style,
    string Color,
    int SoldCount,
    double? AverageRating,
    int ReviewCount
);

/// <summary>
/// Chi tiết sản phẩm đầy đủ (trang product detail)
/// </summary>
public record ProductDetailDto(
    int Id,
    string Name,
    string Slug,
    string Description,
    string MainImageUrl,
    IEnumerable<ProductImageDto> SubImages,
    decimal Price,
    decimal? SalePrice,
    bool IsOnSale,
    int Stock,
    // Kích thước
    double? LengthCm,
    double? WidthCm,
    double? HeightCm,
    double? WeightKg,
    // Phân loại
    string Material,
    string Style,
    string Color,
    CategoryDto Category,
    // Quan hệ
    IEnumerable<ProductCardDto> BundledProducts,
    IEnumerable<ReviewDto> LatestReviews,
    double? AverageRating,
    int ReviewCount
);

public record ProductImageDto(int Id, string Url, string? AltText, int SortOrder);

public record CategoryDto(int Id, string Name, string Slug, string? ImageUrl);
