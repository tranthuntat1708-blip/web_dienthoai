// src/components/product/ProductCard.jsx
// Card sản phẩm dùng trong grid danh sách và slider nổi bật

import { Link } from 'react-router-dom';
import { formatVnd } from '../../utils/format';

/**
 * @param {{ product: import('../../types/product').ProductCard }} props
 */
export default function ProductCard({ product }) {
  const {
    slug,
    name,
    mainImageUrl,
    price,
    salePrice,
    isOnSale,
    averageRating,
 reviewCount,
    soldCount,
  } = product;

  return (
    <Link
      to={`/san-pham/${slug}`}
      className="group block rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-md transition-shadow bg-white"
    >
    {/* Ảnh sản phẩm */}
      <div className="relative aspect-square overflow-hidden bg-gray-50">
        <img
          src={mainImageUrl}
          alt={name}
        loading="lazy"
     className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        />
   {isOnSale && (
  <span className="absolute top-2 left-2 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-full">
 SALE
          </span>
        )}
      </div>

    {/* Thông tin */}
      <div className="p-3 space-y-1">
        <h3 className="text-sm font-semibold text-gray-800 line-clamp-2">{name}</h3>

        {/* Giá */}
        <div className="flex items-center gap-2">
    {isOnSale && salePrice != null ? (
      <>
              <span className="text-red-600 font-bold">{formatVnd(salePrice)}</span>
     <span className="text-gray-400 line-through text-xs">{formatVnd(price)}</span>
      </>
     ) : (
        <span className="text-gray-800 font-bold">{formatVnd(price)}</span>
    )}
  </div>

{/* Đánh giá + Đã bán */}
        <div className="flex items-center justify-between text-xs text-gray-500">
    <span>
            ⭐ {averageRating?.toFixed(1) ?? '—'} ({reviewCount})
      </span>
          <span>Đã bán {soldCount}</span>
        </div>
      </div>
    </Link>
  );
}
